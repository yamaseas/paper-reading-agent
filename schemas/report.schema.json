{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-reading-agent.local/schemas/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "paper_id", "title", "short_summary", "problem",
    "related_work", "method", "experiments", "future_work", "reader_analysis",
    "full_summary", "reading_guide", "claims", "evidence",
    "visual_requests", "unresolved_items"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "paper_id": {"type": "string"},
    "title": {"type": "string"},
    "short_summary": {"type": "string"},
    "problem": {"$ref": "#/$defs/problem"},
    "related_work": {"type": "array", "items": {"$ref": "#/$defs/related_work_item"}},
    "method": {"$ref": "#/$defs/method"},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}},
    "future_work": {"$ref": "#/$defs/future_work"},
    "reader_analysis": {"type": "array", "items": {"$ref": "#/$defs/text_item"}},
    "full_summary": {"type": "string"},
    "reading_guide": {"$ref": "#/$defs/reading_guide"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "diagrams": {"type": "array", "items": {"$ref": "#/$defs/diagram"}},
    "visual_requests": {"type": "array", "items": {"$ref": "#/$defs/visual_request"}},
    "unresolved_items": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "grounded_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "text_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background", "existing_limitation", "research_question",
        "motivation", "claimed_contributions", "evidence_ids"
      ],
      "properties": {
        "background": {"type": "string"},
        "existing_limitation": {"type": "string"},
        "research_question": {"type": "string"},
        "motivation": {"type": "string"},
        "claimed_contributions": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "related_work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "problem", "method", "difference", "evidence_ids"],
      "properties": {
        "work": {"type": "string"},
        "problem": {"type": "string"},
        "method": {"type": "string"},
        "difference": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable", "overview", "inputs", "outputs", "intermediate_artifacts",
        "tools_and_models", "nodes", "edges", "steps", "feedback_loops",
        "decisions", "implementation_details", "evidence_ids"
      ],
      "properties": {
        "applicable": {"type": "boolean"},
        "overview": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "intermediate_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"},
          "description": "方法在步骤之间显式产生或消耗的中间产物（IR、切片、片段、缓存、中间表示等）"
        },
        "tools_and_models": {
          "type": "array",
          "items": {"$ref": "#/$defs/tool_model"},
          "description": "方法依赖的外部工具、库、模型、服务及其在流程中承担的角色"
        },
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "feedback_loops": {
          "type": "array",
          "items": {"$ref": "#/$defs/feedback_loop"},
          "description": "迭代、重试、回退等反馈环；没有证据时必须留空，不要为了图完整而编造"
        },
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"},
          "description": "流程中的判断点与分支走向"
        },
        "implementation_details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "evidence_ids"],
            "properties": {
              "name": {"type": "string"},
              "value": {"type": "string"},
              "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
            }
          }
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "evidence_ids"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "tool_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "evidence_ids"],
      "properties": {
        "name": {"type": "string"},
        "role": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "feedback_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "node_ids", "evidence_ids"],
      "properties": {
        "description": {"type": "string"},
        "node_ids": {
          "type": "array",
          "items": {"type": "string"},
          "description": "参与该反馈环的 method node id；无法确定时留空数组，不要填写猜测的 id"
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "branches", "evidence_ids"],
      "properties": {
        "condition": {"type": "string"},
        "branches": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input", "operation", "output", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "name": {"type": "string"},
        "input": {"type": "array", "items": {"type": "string"}},
        "operation": {"type": "string"},
        "output": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"$ref": "#/$defs/grounded_evidence_ids"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation", "confirmed", "evidence_ids"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "relation": {"type": "string"},
        "confirmed": {"type": "boolean"},
        "evidence_ids": {"$ref": "#/$defs/grounded_evidence_ids"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "input", "operation", "tool_or_model", "output", "why_needed", "evidence_ids"],
      "properties": {
        "step": {"type": "string"},
        "input": {"type": "string"},
        "operation": {"type": "string"},
        "tool_or_model": {"type": "string"},
        "output": {"type": "string"},
        "why_needed": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/grounded_evidence_ids"}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose", "research_question", "dataset", "sample_size", "baselines",
        "models", "metrics", "settings", "main_results", "conclusion",
        "evidence_ids"
      ],
      "properties": {
        "purpose": {"type": "string"},
        "research_question": {
          "type": "string",
          "description": "论文显式给出的 RQ 原文；论文没有编号 RQ 时填空字符串，不要编造编号"
        },
        "dataset": {"type": "string"},
        "sample_size": {"type": "string"},
        "baselines": {"type": "array", "items": {"type": "string"}},
        "models": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "items": {"type": "string"}},
        "settings": {"type": "string"},
        "main_results": {"type": "array", "items": {"type": "string"}},
        "conclusion": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "future_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors_limitations", "authors_future_work", "open_questions", "research_directions"],
      "properties": {
        "authors_limitations": {
          "type": "array",
          "items": {"$ref": "#/$defs/text_item"},
          "description": "作者明确承认的局限（作者观点）"
        },
        "authors_future_work": {
          "type": "array",
          "items": {"$ref": "#/$defs/text_item"},
          "description": "作者明确提出的 future work（作者观点）"
        },
        "open_questions": {
          "type": "array",
          "items": {"$ref": "#/$defs/text_item"},
          "description": "基于本文结果可以继续探索的问题（Reader/LLM 分析）"
        },
        "research_directions": {
          "type": "array",
          "items": {"$ref": "#/$defs/text_item"},
          "description": "值得进一步研究的具体方向（Reader/LLM 分析）"
        }
      }
    },
    "reading_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_sections", "key_concepts", "open_questions", "reproduction_notes", "related_directions"],
      "properties": {
        "key_sections": {
          "type": "array",
          "items": {"$ref": "#/$defs/guide_item"},
          "description": "最值得精读的章节 / Figure / Table"
        },
        "key_concepts": {
          "type": "array",
          "items": {"$ref": "#/$defs/guide_item"},
          "description": "读懂本文需要补充的关键概念"
        },
        "open_questions": {
          "type": "array",
          "items": {"$ref": "#/$defs/guide_item"},
          "description": "最值得继续追问的问题"
        },
        "reproduction_notes": {
          "type": "array",
          "items": {"$ref": "#/$defs/guide_item"},
          "description": "复现本文需要关注的东西（数据、代码、超参、算力、隐含前提）"
        },
        "related_directions": {
          "type": "array",
          "items": {"$ref": "#/$defs/guide_item"},
          "description": "值得继续阅读的相关方向"
        }
      }
    },
    "guide_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "text", "evidence_ids"],
      "properties": {
        "target": {
          "type": "string",
          "description": "条目指向的章节 / 图表 / 概念名称；没有具体指向时填空字符串"
        },
        "text": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "kind", "evidence_ids"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "kind": {"type": "string", "enum": ["author_claim", "reader_inference", "llm_analysis"]},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_type", "pdf_page", "source_id", "section", "figure_or_table", "locator", "quote"],
      "properties": {
        "id": {"type": "string"},
        "source_type": {
          "type": "string",
          "enum": ["text", "image"],
          "description": "text = 依据带页码标记的全文文本；image = 依据某一页或局部补看图"
        },
        "pdf_page": {"type": "integer", "minimum": 1},
        "source_id": {
          "type": "string",
          "description": "text 证据使用 page-NNN-text；image 证据使用 page-NNN（整页）或本次补看提供的 crop id"
        },
        "section": {"type": "string"},
        "figure_or_table": {"type": "string"},
        "locator": {"type": "string"},
        "quote": {"type": "string"}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "nodes", "edges"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "type": {"type": "string", "enum": ["flowchart"]},
        "direction": {"type": "string", "enum": ["LR", "TB"], "default": "LR"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/diagram_node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/diagram_edge"}}
      }
    },
    "diagram_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "label": {"type": "string"},
        "kind": {
          "type": "string",
          "enum": [
            "input", "output", "component", "artifact", "decision",
            "loop", "oracle", "external", "environment", "stage"
          ]
        },
        "group": {
          "type": "string",
          "description": "阶段名；同名的节点在 Mermaid 中被渲染进同一个 subgraph，空字符串表示不分组"
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "diagram_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label", "relation", "confirmed", "evidence_ids"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "label": {"type": "string"},
        "relation": {
          "type": "string",
          "enum": ["data_flow", "control_flow", "dependency", "feedback", "parallel"]
        },
        "confirmed": {"type": "boolean"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "visual_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf_page", "reason", "crop"],
      "properties": {
        "pdf_page": {"type": "integer", "minimum": 1},
        "reason": {"type": "string"},
        "crop": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x0", "y0", "x1", "y1"],
          "properties": {
            "x0": {"type": "number", "minimum": 0, "maximum": 1},
            "y0": {"type": "number", "minimum": 0, "maximum": 1},
            "x1": {"type": "number", "minimum": 0, "maximum": 1},
            "y1": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
